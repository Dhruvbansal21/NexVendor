# ==============================================================================
# NexVendor Marketplace — Environment Configuration
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas Cloud / Local)
# ------------------------------------------------------------------------------
# OPTION A: MongoDB Atlas (Cloud Cluster - Recommended)
# Provide your Atlas cluster URI. The platform automatically routes each domain
# service to its isolated database: marketplace_auth, marketplace_vendor,
# marketplace_catalogue, and marketplace_orders.
#
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# OPTION B: Dedicated Cloud URIs per domain service
# MONGO_URI_AUTH=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marketplace_auth?retryWrites=true&w=majority
# MONGO_URI_VENDOR=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marketplace_vendor?retryWrites=true&w=majority
# MONGO_URI_CATALOGUE=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marketplace_catalogue?retryWrites=true&w=majority
# MONGO_URI_ORDERS=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/marketplace_orders?retryWrites=true&w=majority

# OPTION C: Local MongoDB (Default Development Fallback)
MONGO_URI_AUTH=mongodb://127.0.0.1:27017/marketplace_auth
MONGO_URI_VENDOR=mongodb://127.0.0.1:27017/marketplace_vendor
MONGO_URI_CATALOGUE=mongodb://127.0.0.1:27017/marketplace_catalogue
MONGO_URI_ORDERS=mongodb://127.0.0.1:27017/marketplace_orders

# ------------------------------------------------------------------------------
# 2. SERVICE PORTS
# ------------------------------------------------------------------------------
PORT_GATEWAY=4000
PORT_AUTH=4001
PORT_VENDOR=4002
PORT_CATALOGUE=4003
PORT_ORDERS=4004

# ------------------------------------------------------------------------------
# 3. INTERNAL SERVICE URLS (For Gateway Proxy & Inter-Service Calls)
# ------------------------------------------------------------------------------
AUTH_URL=http://127.0.0.1:4001
VENDOR_URL=http://127.0.0.1:4002
CATALOGUE_URL=http://127.0.0.1:4003
ORDERS_URL=http://127.0.0.1:4004

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Secure random string (minimum 32 characters) for signing JWT tokens
JWT_SECRET=your-production-jwt-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=1d

# Internal header token for service-to-service communication
INTERNAL_API_KEY=your-production-internal-service-secret-key

# ------------------------------------------------------------------------------
# 5. CORS & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:4000/api

# ------------------------------------------------------------------------------
# 6. STORAGE & INITIALIZATION
# ------------------------------------------------------------------------------
# Private filesystem path for KYC merchant documents (not publicly served)
KYC_UPLOAD_DIR=./private_uploads

# Default password applied by `npm run seed` for test accounts
SEED_DEMO_PASSWORD=Demo@12345
